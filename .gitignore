# ============================================================
# Large data files
# ============================================================
data/raw/
data/interim/
data/processed/
**/data/raw/
**/data/interim/
**/data/processed/

# ============================================================
# Large outputs (keep only tables + figures for README)
# ============================================================
outputs/weights/
outputs/data_quality/
outputs/runs/
**/outputs/weights/
**/outputs/data_quality/
**/outputs/runs/

# ============================================================
# CSV files (ignore by default)
# ============================================================
*.csv

# But keep key result tables
!outputs/tables/
!outputs/tables/*.csv
!**/outputs/tables/
!**/outputs/tables/*.csv

# Keep figures for the README
!outputs/figures/
!outputs/figures/**/*.png
!**/outputs/figures/
!**/outputs/figures/**/*.png

# ============================================================
# Script-generated artifacts
# ============================================================
scripts/data/
scripts/outputs/
**/scripts/data/
**/scripts/outputs/

# ============================================================
# Secrets — NEVER commit
# ============================================================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ============================================================
# Local backups
# ============================================================
golden_master/
**/golden_master/

